      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 or 403', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
              "});",
              "var body = pm.response.json();",
              "if (pm.response.code === 200) {",
              "  pm.expect(body).to.have.property('composer_profile');",
              "  pm.expect(body.composer_profile).to.have.property('display_name');",
              "} else {",
              "  pm.expect(body.detail.code).to.eql('authorization_error');",
              "}"
